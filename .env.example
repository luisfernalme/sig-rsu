# Arquivo de variáveis de ambiente para desenvolvimento
# Copie este arquivo como .env e ajuste as configurações conforme necessário

# Django Settings
DEBUG=1
SECRET_KEY=django-insecure-change-this-in-production-environment
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
DATABASE_URL=postgres://residuos_user:residuos_password@db:5432/residuos_db

# Redis
REDIS_URL=redis://redis:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Settings (opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# React App Settings
REACT_APP_API_URL=http://localhost:8000/api